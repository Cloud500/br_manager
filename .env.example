# Django Core Settings
DJANGO_SECRET_KEY=your-secret-key-here-change-me
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database Settings
DB_NAME=br_manager
DB_USER=br_manager
DB_PASSWORD=your-database-password
DB_HOST=localhost
DB_PORT=5432

# Email Settings
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@br-manager.local

# Logging Settings
DJANGO_LOG_FILE=/var/log/br_manager/django.log
LOG_LEVEL=INFO
