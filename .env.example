# Django Core Settings
DJANGO_SECRET_KEY=your-secret-key-here-change-me
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=

# Database Settings
DB_NAME=br_manager
DB_USER=br_manager
DB_PASSWORD=your-database-password
DB_HOST=localhost
DB_PORT=5432

# Email Settings
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@br-manager.local

# Logging Settings
DJANGO_LOG_FILE=/var/log/br_manager/django.log
LOG_LEVEL=INFO
WEB_CONCURRENCY=2
DJANGO_SEED_TESTDATA_CONFIG=testdata_config_small.json

# Optional initial root user for Docker startup
# If ROOT_USER_EMAIL and ROOT_USER_PASSWORD are set, the container creates
# this superuser after migrations when it does not already exist.
ROOT_USER_EMAIL=
ROOT_USER_PASSWORD=
ROOT_USER_FIRST_NAME=Admin
ROOT_USER_LAST_NAME=BR-Manager
ROOT_USER_GENDER=M
